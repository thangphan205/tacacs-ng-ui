# Empty: the SPA calls its own origin and the dev server / nginx proxies
# /api, /mcp, /docs and /redoc to the backend. Set this only to point the
# bundle at a backend on a different origin.
VITE_API_URL=
# Where `npm run dev` forwards the proxied paths.
VITE_DEV_API_PROXY=http://localhost:8000
# Playwright's helpers run under Node, not the browser, so they need an
# absolute URL rather than the origin-relative one the bundle uses.
PLAYWRIGHT_API_URL=http://localhost:8000
MAILCATCHER_HOST=http://localhost:1080
